# Copy this file to .env and fill in real values — .env is gitignored, this file is not.
# Get both URLs from: Supabase dashboard → your project → Connect → ORMs → Prisma.

# Pooled connection (port 6543, pgbouncer=true) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — used only for running migrations.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"
